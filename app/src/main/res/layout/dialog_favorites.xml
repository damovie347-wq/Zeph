<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_favorites_title"
        android:textColor="@color/text_primary_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFavoritesListOrEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dialog_favorites_empty"
        android:textColor="@color/text_secondary_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAddFavoriteIp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_outlined"
        android:hint="IP Adresi (Örn: 192.168.49.1)"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary_white"
        android:textColorHint="@color/text_hint_dim"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCloseFavorites"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_primary_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAddFavoriteAction"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_cyan_pill"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/btn_add"
            android:textColor="@color/accent_cyan_dark_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
