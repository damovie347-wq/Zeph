<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_device_phone"
            app:tint="@color/accent_cyan_bright" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIncomingSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kind Carrot"
                android:textColor="@color/text_primary_white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Size dosya göndermek istiyor"
                android:textColor="@color/accent_cyan_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_nearby"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvIncomingSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dosya Sayısı: 1 • Toplam: 120.5 MB"
            android:textColor="@color/text_primary_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIncomingFileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:text="• video.mp4 (120.5 MB)"
            android:textColor="@color/text_secondary_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDeclineIncoming"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_outline_pill"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Reddet"
            android:textColor="@color/accent_danger_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAcceptIncoming"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_cyan_pill"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="Kabul Et"
            android:textColor="@color/accent_cyan_dark_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
