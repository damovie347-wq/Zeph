<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_text_title"
        android:textColor="@color/text_primary_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMessageInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input_outlined"
        android:hint="Gönderilecek metin..."
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary_white"
        android:textColorHint="@color/text_hint_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelTextDialog"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_primary_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmTextDialog"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_cyan_pill"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/btn_confirm"
            android:textColor="@color/accent_cyan_dark_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
