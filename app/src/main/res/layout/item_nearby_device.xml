<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_nearby"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivPeerIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_device_phone"
        app:tint="@color/accent_cyan_bright" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Galaxy S24 Ultra"
            android:textColor="@color/text_primary_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPeerBandTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_band"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="5 GHz Wi-Fi Direct"
                android:textColor="@color/accent_cyan_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPeerAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="192.168.49.1"
                android:textColor="@color/text_secondary_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnSendToPeer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_cyan_pill"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Gönder"
        android:textColor="@color/accent_cyan_dark_text"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
